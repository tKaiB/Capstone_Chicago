        "# Simplify Location Descriptions into Street, Residence, Commercial, and Other\n",
        "def simplify_location(loc):\n",
        "    loc = str(loc).upper()\n",
        "    if 'RESIDENCE' in loc or 'APARTMENT' in loc or 'HOUSE' in loc:\n",
        "        return 'Residence'\n",
        "    elif 'STREET' in loc or 'SIDEWALK' in loc or 'ALLEY' in loc:\n",
        "        return 'Street'\n",
        "    elif 'COMMERCIAL' in loc or 'STORE' in loc or 'RESTAURANT' in loc or 'BANK' in loc or 'OFFICE' in loc:\n",
        "        return 'Commercial'\n",
        "    else:\n",
        "        return 'Other'\n",
        "\n",
        "df['Simplified_Location'] = df['Location Description'].apply(simplify_location)\n",
        "\n",
        "# Group by Year, Community Area, and Simplified Location\n",
        "location_trends = df.groupby(['Year', 'Community Area', 'Simplified_Location']).size().reset_index(name='Count')\n",
        "total_loc_trends = df.groupby(['Year', 'Community Area']).size().reset_index(name='Total_Count')\n",
        "\n",
        "location_percentage = pd.merge(location_trends, total_loc_trends, on=['Year', 'Community Area'])\n",
        "location_percentage['Percentage'] = (location_percentage['Count'] / location_percentage['Total_Count'] * 100).round(2)\n",
        "\n",
        "# Filter for the top 10 highest-crime community areas\n",
        "top_10_communities = total_loc_trends.groupby('Community Area')['Total_Count'].sum().nlargest(10).index\n",
        "location_percentage_filtered = location_percentage[location_percentage['Community Area'].isin(top_10_communities)]\n",
        "\n",
        "fig_loc_shift = px.bar(\n",
        "    location_percentage_filtered,\n",
        "    x='Simplified_Location',\n",
        "    y='Percentage',\n",
        "    color='Year',\n",
        "    facet_col='Community Area',\n",
        "    facet_col_wrap=5,\n",
        "    barmode='group',\n",
        "    title='How Location Distribution Shifted Across Top 10 Community Areas (2020 vs 2021 vs 2022)',\n",
        "    labels={'Percentage': 'Percentage of Total Crimes (%)', 'Simplified_Location': 'Location Category'},\n",
        "    color_discrete_sequence=px.colors.qualitative.Set2\n",
        ")\n",
        "fig_loc_shift.show()"
