        "df['Year'] = df['Date'].dt.year\n",
        "df['Month'] = df['Date'].dt.month\n",
        "\n",
        "monthly = df.groupby(['Year', 'Month']).size().reset_index(name='Crime Count')\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "for year in sorted(monthly['Year'].unique()):\n",
        "    year_data = monthly[monthly['Year'] == year]\n",
        "    fig.add_trace(go.Scatter(\n",
        "        x=year_data['Month'],\n",
        "        y=year_data['Crime Count'],\n",
        "        mode='lines+markers',\n",
        "        name=str(year)\n",
        "    ))\n",
        "\n",
        "fig.update_layout(\n",
        "    title='Monthly Crime Frequency by Year',\n",
        "    xaxis=dict(\n",
        "        title='Month',\n",
        "        tickmode='array',\n",
        "        tickvals=list(range(1, 13)),\n",
        "        ticktext=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']\n",
        "    ),\n",
        "    yaxis_title='Crime Count',\n",
        "    legend_title='Year'\n",
        ")\n",
        "fig.show()"
