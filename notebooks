        "    color='Arrest Rate (%)',\n",
        "    color_continuous_scale='Reds_r'\n",
        ")\n",
        "fig_crime.update_layout(yaxis={'categoryorder':'total descending'})\n",
        "fig_crime.show()\n",
        "\n",
