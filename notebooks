      "source": [
        "import plotly.express as px\n",
        "\n",
        "# Calculate arrest rates by District\n",
        "district_arrest = df.groupby('District')['Arrest'].agg(['count', 'mean']).reset_index()\n",
        "district_arrest.columns = ['District', 'Total Incidents', 'Arrest Rate']\n",
        "district_arrest['Arrest Rate (%)'] = (district_arrest['Arrest Rate'] * 100).round(2)\n",
        "district_arrest['District'] = district_arrest['District'].astype(str)\n",
        "\n",
        "# Calculate arrest rates by Time of Day\n",
        "# Time_Of_Day mapping: 1 (00:00~05:59), 2 (6:00~11:59), 3 (12:00~17:59), 4 (18:00~23:59)\n",
        "time_arrest = df.groupby('Time_Of_Day')['Arrest'].agg(['count', 'mean']).reset_index()\n",
        "time_arrest.columns = ['Time_Of_Day', 'Total Incidents', 'Arrest Rate']\n",
        "time_arrest['Arrest Rate (%)'] = (time_arrest['Arrest Rate'] * 100).round(2)\n",
        "time_map = {1: 'Night (00:00 - 05:59)', 2: 'Morning (06:00 - 11:59)', 3: 'Afternoon (12:00 - 17:59)', 4: 'Evening (18:00 - 23:59)'}\n",
        "time_arrest['Time Period'] = time_arrest['Time_Of_Day'].map(time_map)\n",
        "\n",
        "# Plotting District Arrest Rates\n",
        "fig_dist = px.bar(\n",
        "    district_arrest,\n",
        "    x='District',\n",
        "    y='Arrest Rate (%)',\n",
        "    title='Arrest Rate (%) by Chicago Police District',\n",
        "    labels={'District': 'Police District', 'Arrest Rate (%)': 'Arrest Rate (%)'},\n",
        "    color='Arrest Rate (%)',\n",
        "    color_continuous_scale='Blues'\n",
        ")\n",
        "fig_dist.update_layout(xaxis={'categoryorder':'total descending'})\n",
        "fig_dist.show()\n",
        "\n",
        "# Plotting Time of Day Arrest Rates\n",
        "fig_time = px.bar(\n",
        "    time_arrest,\n",
        "    x='Time Period',\n",
        "    y='Arrest Rate (%)',\n",
        "    title='Arrest Rate (%) by Time of Day',\n",
        "    labels={'Time Period': 'Time of Day', 'Arrest Rate (%)': 'Arrest Rate (%)'},\n",
        "    color='Arrest Rate (%)',\n",
        "    color_continuous_scale='Purples'\n",
        ")\n",
        "fig_time.show()"
      ],
