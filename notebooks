      "source": [
        "import holidays\n",
        "\n",
        "# Initialize Illinois/US holidays\n",
        "us_holidays = holidays.US(state='IL')\n",
        "\n",
        "# Extract unique dates in YYYY-MM-DD format to speed up holiday lookup\n",
        "unique_dates = df['Date'].dt.date.unique()\n",
        "\n",
        "# Create a mapping dictionary for holidays found in our dataset\n",
        "holiday_mapping = {}\n",
        "current_label = 1\n",
        "\n",
        "# Assign 0 for non-holidays\n",
        "holiday_mapping['Non-Holiday'] = 0\n",
        "\n",
        "# Check each unique date and build our mapping\n",
        "date_to_holiday_name = {}\n",
        "for d in unique_dates:\n",
        "    h_name = us_holidays.get(d)\n",
        "    if h_name:\n",
        "        # Clean holiday names slightly (e.g., handling Observed days if needed)\n",
        "        if h_name not in holiday_mapping:\n",
        "            holiday_mapping[h_name] = current_label\n",
        "            current_label += 1\n",
        "        date_to_holiday_name[d] = h_name\n",
        "    else:\n",
        "        date_to_holiday_name[d] = 'Non-Holiday'\n",
        "\n",
        "# Create the 'Holiday' column by mapping the date to its holiday name and then to its number\n",
        "df['Holiday_Name'] = df['Date'].dt.date.map(date_to_holiday_name)\n",
        "df['Holiday'] = df['Holiday_Name'].map(holiday_mapping)\n",
        "\n",
        "# Drop the temporary Holiday_Name helper column if you prefer to keep the dataset clean\n",
        "df.drop(columns=['Holiday_Name'], inplace=True)\n",
        "\n",
        "# Print the legend mapping numbers to holiday names\n",
        "print(\"--- Holiday Legend Mapping ---\")\n",
        "for name, label in sorted(holiday_mapping.items(), key=lambda x: x[1]):\n",
        "    print(f\"ID: {label} -> {name}\")\n",
        "\n",
        "# Verify by showing some detected holidays\n",
        "display(df[df['Holiday'] > 0][['Date', 'Holiday']].head())"
      ],
