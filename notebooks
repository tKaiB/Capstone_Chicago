        "import pandas as pd\n",
        "import plotly.express as px\n",
        "\n",
        "# Calculate overall crime type arrest rates\n",
        "crime_arrest = df.groupby('Primary Type')['Arrest'].agg(['count', 'mean']).reset_index()\n",
        "crime_arrest.columns = ['Primary Type', 'Total Incidents', 'Arrest Rate']\n",
        "crime_arrest['Arrest Rate (%)'] = (crime_arrest['Arrest Rate'] * 100).round(2)\n",
        "# Filter out crime types with very few incidents to avoid noise\n",
        "low_arrest_crimes = crime_arrest[crime_arrest['Total Incidents'] >= 100].sort_values(by='Arrest Rate (%)').head(10)\n",
        "\n",
        "# Calculate overall location arrest rates\n",
        "location_arrest = df.groupby('Location Description')['Arrest'].agg(['count', 'mean']).reset_index()\n",
        "location_arrest.columns = ['Location Description', 'Total Incidents', 'Arrest Rate']\n",
        "location_arrest['Arrest Rate (%)'] = (location_arrest['Arrest Rate'] * 100).round(2)\n",
        "# Filter out locations with very few incidents\n",
        "low_arrest_locations = location_arrest[location_arrest['Total Incidents'] >= 100].sort_values(by='Arrest Rate (%)').head(10)\n",
        "\n",
        "# Plotting Crime Types with lowest arrest rates\n",
        "fig_crime = px.bar(\n",
        "    low_arrest_crimes,\n",
        "    x='Arrest Rate (%)',\n",
